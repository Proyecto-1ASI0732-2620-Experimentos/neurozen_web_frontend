# NeuroZen App - Variables de Entorno de Desarrollo
# @author Juan Carlos Angulo

# API Configuration para desarrollo local (.NET Backend)
# VITE_API_MODE=api  -> usa la API real en VITE_API_BASE_URL
# VITE_API_MODE=static -> usa public/data/db.json (modo demostración, sin backend)
VITE_API_BASE_URL=http://localhost:5059
VITE_API_MODE=api
VITE_API_TIMEOUT=10000

# App Configuration
VITE_APP_NAME=NeuroZen
VITE_APP_VERSION=1.0.0-dev

# Backend Configuration
VITE_BACKEND_TYPE=dotnet
