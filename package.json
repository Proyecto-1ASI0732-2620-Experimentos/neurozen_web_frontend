{
  "name": "front-end-neurozen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "json-server --watch server/db.json --port 3002",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "deploy:setup": "bash deploy-static.sh",
    "deploy:frontend": "npm run build && firebase deploy --only hosting:frontend",
    "deploy:all": "npm run deploy:frontend",
    "serve:emulators": "firebase emulators:start --only hosting"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "chart.js": "^4.5.0",
    "material-symbols": "^0.27.2",
    "vue": "^3.5.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "json-server": "^1.0.0-beta.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7"
  }
}
