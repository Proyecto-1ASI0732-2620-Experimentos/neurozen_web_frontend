{
  "name": "front-end-neurozen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "api": "json-server --watch server/db.json --port 3002",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "chart.js": "^4.5.0",
    "material-symbols": "^0.27.2",
    "vue": "^3.5.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "json-server": "^1.0.0-beta.3",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
